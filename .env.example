# Copy to .env and fill in. SECRETS ONLY — everything else is config/console.json.

# ── Server ──────────────────────────────────────────────────────────────
PORT=8100
HOST=0.0.0.0
# Public origin, no trailing slash. An https:// value turns on Secure cookies.
PUBLIC_ORIGIN=https://console.ojee.net

# ── Secrets ─────────────────────────────────────────────────────────────
# Signs session cookies. 32+ chars: openssl rand -hex 32
# Comma-separate to rotate without logging everyone out — newest FIRST, keep
# the old key until existing sessions age out, then drop it.
SESSION_SECRET=

# Base32 TOTP secret: npm run setup-totp
TOTP_SECRET=

# Signs the X-Console-Auth header modules use to verify a request really came
# from the console. Defaults to SESSION_SECRET; a separate value is better,
# because then a leaked module secret cannot also forge sessions.
MODULE_IDENTITY_SECRET=

# ── Auth tuning ─────────────────────────────────────────────────────────
SESSION_HOURS=12
DEVICE_TRUST_DAYS=30
TOTP_MAX_FAILURES=8

# ── Tailnet gate ────────────────────────────────────────────────────────
# The gate prefers `tailscale whois`, which is authoritative. These only
# matter when the CLI is unavailable — most often in a container that does
# not share the host's network namespace.
# TRUSTED_CIDRS=100.64.0.0/10,fd7a:115c:a1e0::/48
# TAILSCALE_CLI=/usr/bin/tailscale

# Honour Tailscale-User-Login headers. ONLY turn this on when something in
# front of the console (tailscale serve) guarantees them — a header is
# forgeable by anything that can reach the port directly.
TRUST_PROXY_IDENTITY=false

# Let 127.0.0.1 through the tailnet gate. DEVELOPMENT ONLY. Never on the box
# that faces the tailnet.
ALLOW_LOOPBACK=false

# ── Module origins (override config/console.json) ───────────────────────
# MODULE_HOME_ORIGIN=http://home:8110
# MODULE_REMOTE_ORIGIN=http://remote:8200
# MODULE_LOQ_ORIGIN=http://100.81.241.55:8300
# MODULE_AGENT_ORIGIN=http://dashboard:8080

# ── Storage ─────────────────────────────────────────────────────────────
# Trusted-device store lives here. Persist it, or every device has to
# re-enrol on each deploy.
DATA_DIR=./data
