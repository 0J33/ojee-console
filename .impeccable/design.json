      "html": "<button class=\"ds-btn ds-btn-pri\">Restart service</button>",
      "css": ":host,.ds{--page:#0a0a0a;--panel:#111112;--raised:#18181a;--hover:#1c1c1e;--line:#232325;--line-2:#2f2f32;--fg:#ededef;--fg-2:#a3a3aa;--fg-3:#8a8a92;--inv-fg:#0a0a0a;--acc:#2fd8ee;--ok:#3fcf7f;--warn:#f2b13c;--err:#ff6262;--sh-1:0 1px 2px rgba(0,0,0,.4);--sh-3:0 28px 70px -12px rgba(0,0,0,.75);--r-1:4px;--r-2:6px;--r-3:8px;--r-4:10px;--ease-out:cubic-bezier(.23,1,.32,1);font-family:Geist,ui-sans-serif,system-ui,sans-serif;color:var(--fg)}.ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:6px;height:32px;padding:0 12px;border-radius:var(--r-2,6px);border:1px solid var(--line-2,#2f2f32);background:var(--panel,#111112);font:500 13px/1 Geist,ui-sans-serif,system-ui,sans-serif;color:var(--fg,#ededef);cursor:pointer;transition:transform 120ms var(--ease-out,cubic-bezier(.23,1,.32,1)),background-color 120ms ease}.ds-btn:hover{background:var(--hover,#1c1c1e)}.ds-btn:active{transform:scale(.97)}.ds-btn:focus-visible{outline:2px solid var(--acc,#2fd8ee);outline-offset:2px}.ds-btn-pri{background:var(--fg,#ededef);color:var(--inv-fg,#0a0a0a);border-color:transparent}.ds-btn-pri:hover{background:color-mix(in srgb,var(--fg,#ededef) 86%,var(--page,#0a0a0a))}"
